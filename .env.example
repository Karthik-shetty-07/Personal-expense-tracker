# ============================================================
# Personal Expense Tracker - Environment Variables
# DO NOT commit real secrets (.env) to version control!
# Add these variables to your Vercel Project Settings for production deployment.
# ============================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# MongoDB Database URI (Keep secure, never commit to git)
# Example: mongodb+srv://username:password@cluster.mongodb.net/expenseDB
MONGO_URI=your_mongodb_connection_string

# JWT Secret for Session Auth (Use a strong random key in production)
JWT_SECRET=supersecret_jwt_key_change_in_production
JWT_EXPIRES_IN=30d

# LLM API (Groq - Securely stored on backend server only)
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile

# Client Configurations
CLIENT_URL=http://localhost:5173
VITE_API_URL=/api
